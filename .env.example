# ==============================================================================
# VARIABLES DE ENTORNO - TRAINERAPP (.env.example)
# ==============================================================================

# Clave secreta de Flask para sesiones
SECRET_KEY=clave-secreta-desarrollo-trainerapp

# Google Gemini API Key (Caso de Uso CU17 / Requerimiento RF14)
# Obtén tu clave en: https://aistudio.google.com/
GEMINI_API_KEY=

# Modelo seleccionado para optimizar consumo y velocidad en free tier
GEMINI_MODEL=gemini-3.5-flash-lite
